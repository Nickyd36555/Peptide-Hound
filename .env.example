# Peptide Hound — environment variables
# Copy this file to .env and fill in your credentials.
# The server reads these at startup; never commit real credentials to git.
#
# Usage:
#   cp .env.example .env
#   # edit .env with your real credentials
#   export $(cat .env | xargs)
#   uvicorn backend.main:app --reload

# ── Login-gated vendor credentials ────────────────────────────────────────
# Leave blank to skip that vendor during scraping.

# NuLife Peptides  (nulifepeptides.com)
NULIFE_EMAIL=
NULIFE_PASSWORD=

# Liberty Peptides  (libertypeptides.com)
LIBERTY_EMAIL=
LIBERTY_PASSWORD=

# Prime Peptides  (primepeptides.com)
PRIME_PEPTIDES_EMAIL=
PRIME_PEPTIDES_PASSWORD=

# Loti Labs  (lotilabs.com)
LOTI_LABS_EMAIL=
LOTI_LABS_PASSWORD=

# ── Optional overrides ─────────────────────────────────────────────────────
# DATABASE_URL=sqlite:///./peptides.db
